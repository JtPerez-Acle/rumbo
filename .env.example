# Estudio IA — environment variables reference.
# On Railway these are set via `railway variables --set "K=V"` (do NOT commit real values).
# Locally, MoneyPrinterTurbo/config.toml holds the Pexels key; the vars below drive
# the cloud producer/publisher/scheduler.

# --- Required for script generation ---
OPENROUTER_API_KEY=           # OpenRouter key (sk-or-v1-...)
LLM_MODEL=deepseek/deepseek-v4-pro   # or anthropic/claude-opus-4.8

# --- Required for rendering ---
PEXELS_API_KEY=               # free key from pexels.com/api

# --- Required in cloud (Railway provides these) ---
DATABASE_URL=                 # Postgres; Railway reference ${{Postgres.DATABASE_URL}}
PORT=8765

# --- Dashboard access gate (public deployments) ---
DASHBOARD_TOKEN=              # any long random string; visit dashboard once as ?token=THIS

# --- Scheduler ---
ENABLE_SCHEDULER=0            # 0 = off (default while no Upload-Post). 1 = run produce+publish crons
SCHEDULE_TZ=America/Santiago
TZ=America/Santiago
# PRODUCE_AT=06:00            # optional override for daily render time
# BUFFER_MAX=5               # optional: max unpublished videos buffered per channel

# --- Publishing (LAUNCH BLOCKER — set when Upload-Post account is ready) ---
UPLOAD_POST_API_KEY=          # from upload-post.com; also set upload_post_username per channel TOML
# AUTO_APPROVE=0             # keep unset/0 to require dashboard approval before publishing
