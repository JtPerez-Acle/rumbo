---
/* One drawn icon. Decorative by default — these sit beside their own label
 * everywhere they appear, so announcing them would just read the label twice.
 */
import { PATHS } from '../lib/icons.js';
const { name, class: cls = 'ic' } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><path d={PATHS[name] || ''} /></svg>
