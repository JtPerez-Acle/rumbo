---
/* The whole catalog at its own address.
 *
 * It used to exist only as a section below a full lesson on the landing,
 * reachable by scrolling past all of it.
 *
 * Zero JavaScript. Fourteen course links and six disclosure sections, all in
 * the HTML the server sends — which is also what a crawler gets, where before
 * hydration replaced fourteen crawlable anchors with divs.
 */
import Public from '../layouts/Public.astro';
import Catalog from '../components/Catalog.astro';
import Doors from '../components/Doors.astro';
import { SITE_NAME } from '../lib/site.js';
import catalog from '../data/catalog.json';

const courses = catalog.courses;
---
<Public
  here="cursos"
  title={`Todos los cursos — ${SITE_NAME}`}
  description="Los módulos que tu ruta puede tomar, con el temario abierto entero y el documento con el que termina cada uno."
>
  {/* NOT "14 cursos, 420 lecciones" in the title or description: an inventory
      count is the marketplace's own positioning, it is the one number a
      competitor beats trivially, and the description is what every WhatsApp
      share of this page previews as. */}
  <div class="demohead hero">
    <div class="eyebrow">La biblioteca</div>
    <h1>Todo lo que puedes estudiar aquí.</h1>
    <p class="muted" style="margin-top:10px">
      Cada curso abre su temario entero: los módulos, lo que sabrás hacer al
      terminar cada uno, y las lecciones una por una. Nada está escondido detrás
      del registro.
    </p>
  </div>

  <Catalog courses={courses} />

  <p class="faint t-sm" style="margin-top:var(--s4)">
    {courses.length} cursos · toca cualquiera para leer su temario completo.
  </p>

  <Doors kind="ghost" />
</Public>
