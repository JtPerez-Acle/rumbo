---
/* The job analyser. docs/08 calls this the acquisition asset and says it ships
 * standalone — it could not be linked to at all before this route existed.
 *
 * The whole page is one island because the whole page is one flow: form,
 * two minutes of work, result. What surrounds it — the header and the meta
 * tags a share preview reads — is static, which is what matters for a link
 * somebody pastes into WhatsApp.
 */
import Public from '../layouts/Public.astro';
import JobAnalyser from '../components/JobAnalyser.svelte';
import { SITE_NAME } from '../lib/site.js';
---
<Public
  here="oferta"
  title={`Pega la oferta que quieres — ${SITE_NAME}`}
  description="Te decimos qué pide de verdad, qué cubrimos, qué no, y con qué documento llegar a la entrevista. Sin cuenta."
>
  {/* Wrapped, and the wrapper is load-bearing. `body.wide .app > *` places
      each direct child in the text column, but Astro gives <astro-island>
      `display:contents` — so the island is not a grid item, its CHILDREN
      become the grid items instead, and they inherit no column. They land in
      the implicit track past `full-end`: the whole form rendered 32px wide
      against the right edge. A real element here takes the placement. */}
  <div>
    <JobAnalyser client:load />
  </div>
</Public>
